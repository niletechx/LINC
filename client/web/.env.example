# ─── LINC Web Client — Environment Variables ─────────────────────────────────
# Copy to .env.local for local development.
# In production (Render), set these in the Render Dashboard Environment tab.

# Full URL of the LINC backend API (no trailing slash).
# - Local dev:  http://localhost:5000/api
# - Production: https://linc-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api
