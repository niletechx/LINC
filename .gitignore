# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.npm

# ─── Build outputs ────────────────────────────────────────────────────────────
dist/
build/
.next/

# ─── Environment variables ────────────────────────────────────────────────────
# .env files at any depth (covers server/.env, client/web/.env, etc.)
.env
.env.local
.env.production
.env.staging
# Keep .env.example files — they are safe to commit
!.env.example
!.env.*.example

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ─── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Temp files only — migrations ARE tracked in git (source of truth for DB schema)
supabase/.temp/
