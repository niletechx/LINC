# ==============================================================================
# LINC Backend — Production Environment (Render)
# Copy this to your Render Dashboard Environment Variables tab.
# Never commit real secrets to git.
# ==============================================================================

# ─── Server Network ──────────────────────────────────────────────────────────
PORT=10000
NODE_ENV=production
# Replace with your actual Render service URLs after first deploy
SERVER_URL=https://linc-backend-2zcf.onrender.com
CLIENT_URL=https://linc-web.onrender.com
CORS_ORIGIN=https://linc-web.onrender.com

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Use a strong random 256-bit key: openssl rand -hex 32
JWT_SECRET=generate-a-strong-256-bit-secret-key-here-for-production
JWT_EXPIRES_IN=7d

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your-production-gemini-api-key

# ─── Chapa Payment Gateway ───────────────────────────────────────────────────
# Switch to LIVE key for production: CHASECK_LIVE-...
CHAPA_SECRET_KEY=CHASECK_LIVE-your-live-chapa-key
