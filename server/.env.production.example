# ==============================================================================
# LINC Backend Production Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production
SERVER_URL=https://api.linc.et
CLIENT_URL=https://app.linc.et
CORS_ORIGIN=https://app.linc.et,https://admin.linc.et

# Authentication & Security
JWT_SECRET=generate-a-strong-256-bit-secret-key-here-for-production
JWT_EXPIRES_IN=7d

# Supabase Managed Cloud DB (Recommended)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# PostgreSQL Direct Connection (For Docker / On-Premise Deployments)
DB_HOST=postgres
DB_PORT=5432
DB_USER=linc_user
DB_PASSWORD=your_strong_postgres_password
DB_NAME=linc_db

# Google Gemini AI Service
GEMINI_API_KEY=your-production-gemini-api-key

# Chapa Payment Gateway (Ethiopia)
CHAPA_SECRET_KEY=CHASECK_LIVE-your-live-chapa-key
